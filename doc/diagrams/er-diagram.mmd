erDiagram
    customer ||--o{ pawn_ticket : "มีตั๋ว"
    pledged_item ||--|| appraisal : "ประเมิน"
    pledged_item ||--o| pawn_ticket : "ค้ำประกัน"
    pledged_item ||--o| sale_record : "ขายเมื่อหลุด"
    interest_policy ||--|{ rate_tier : "ขั้นอัตรา"
    interest_policy ||--o{ pawn_ticket : "ใช้คิดดอก"
    pawn_ticket ||--|{ ledger_entry : "รายการบัญชี"
    pawn_ticket ||--o{ notification_log : "แจ้งเตือน"
